# Copy to .env.local for local development. Never commit real values.
# In production these are set in AWS Amplify (App settings > Environment variables).

# Supabase (public by design; Row Level Security protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public address of the site, used in email links. Leave empty until the domain is live.
NEXT_PUBLIC_SITE_URL=

# Server only: never prefix these with NEXT_PUBLIC_
RESEND_API_KEY=
SEND_EMAIL_HOOK_SECRET=
# Optional, defaults to smbhub.ca
EMAIL_DOMAIN=

# Bot check (Cloudflare Turnstile) on sign-up, log-in, verify and forgot-password.
# The site key is public. The SECRET key goes only into Supabase: Authentication > Attack Protection > CAPTCHA.
# Leave empty to switch the check off. Set this in Amplify and deploy BEFORE turning CAPTCHA on in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
